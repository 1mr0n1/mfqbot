# Backend
OPENROUTER_API_KEY=sk-or-v1-...
NVIDIA_API_KEY=nvapi-...
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Bot
TELEGRAM_BOT_TOKEN=123456:ABC...   # from @BotFather
BACKEND_URL=http://127.0.0.1:8000

# Userbot (Telegram user account) — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_REPLY_MODE=allowlist   # allowlist = only chats enabled with ".ai on"; all = every private chat
USERBOT_MODELS=omni,nemotron,qwen   # tried in order; omni sees photos (add ",local" for a local fallback)
USERBOT_HUMAN_PACING=true    # false = reply instantly instead of human-like delays
USERBOT_MEDIA=true           # stickers, GIFs and your recorded voice/round-video clips

# Optional local model (LM Studio / Ollama, OpenAI-compatible)
LOCAL_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LOCAL_MODEL=gemma-4-e4b-it-mlx
DEFAULT_MODEL=qwen   # qwen | nemotron | local
USERBOT_AUTO_BIO=true        # the account rewrites its own bio every 6-14h (never at night)
USERBOT_VISION=true          # pass incoming photos to a vision-capable model
USERBOT_PFP_FROM_CHATS=true  # let people set your profile photo by sending one and asking (safety-checked)
USERBOT_REMEMBER=true        # keep notes about what each person tells you
USERBOT_SMART_SKIP=true      # react or stay silent when a message needs no reply
USERBOT_HANDOFF=true         # leave sensitive messages (money, emergencies, upset people) to you
USERBOT_REVIEW=true          # second look at every draft (language, nonsense words, missed questions)
USERBOT_RHYTHM=true          # sleep / school schedule / occasional slow replies / going offline
USERBOT_SLEEP=00:00-07:00    # local time: nothing is read or answered; answered after waking up
USERBOT_BUSY=08:30-15:30     # weekdays: replies come 3-20 minutes late
USERBOT_VOICE=true           # transcribe voice messages locally with Whisper (downloads ~460 MB once)
USERBOT_TYPO_CHANCE=0.06     # share of casual messages sent with a typo that then gets fixed
USERBOT_SUMMARY_TIME=21:30   # evening digest in Saved Messages (empty = off)
USERBOT_GROUPS=true          # in groups: reply only when mentioned or replied to
USERBOT_TEMPERATURE=0.5      # lower = steadier wording, fewer made-up words
USERBOT_EMOJI_CHANCE=0.04    # share of replies allowed to keep one emoji
